From 8ef0016ecfc26baed802cee67ef3aa6b2f066b27 Mon Sep 17 00:00:00 2001
From: Arian <arian.kulmer@web.de>
Date: Tue, 15 Oct 2024 01:44:04 +0200
Subject: [PATCH 8/10] Start gallery as a new task

When launched from lockscreen user will have to unlock for the gallery to be opened, then the gallery is living in the camera process which is wrong.
Let it create a new task for it.
---
 smali/a0/k5.smali                     | 5 +++++
 smali/com/android/camera/Camera.smali | 5 +++++
 2 files changed, 10 insertions(+)

diff --git a/smali/a0/k5.smali b/smali/a0/k5.smali
index 0de1dad6..8da275c8 100644
--- a/smali/a0/k5.smali
+++ b/smali/a0/k5.smali
@@ -366,6 +366,11 @@
     invoke-virtual {v1, p0, v2}, Landroid/content/Intent;->putExtra(Ljava/lang/String;Z)Landroid/content/Intent;
 
     :cond_d
+    # FLAG_ACTIVITY_NEW_TASK
+    const/high16 p0, 0x10000000
+
+    invoke-virtual {v1, p0}, Landroid/content/Intent;->addFlags(I)Landroid/content/Intent;
+
     return-object v1
 .end method
 
diff --git a/smali/com/android/camera/Camera.smali b/smali/com/android/camera/Camera.smali
index ae70d0e2..4478e5e9 100644
--- a/smali/com/android/camera/Camera.smali
+++ b/smali/com/android/camera/Camera.smali
@@ -5641,6 +5641,11 @@
 
     invoke-virtual {p0, p1}, Landroid/content/Intent;->addCategory(Ljava/lang/String;)Landroid/content/Intent;
 
+    # FLAG_ACTIVITY_NEW_TASK
+    const/high16 p1, 0x10000000
+
+    invoke-virtual {p0, p1}, Landroid/content/Intent;->addFlags(I)Landroid/content/Intent;
+
     invoke-virtual {v0, p0}, Landroid/app/Activity;->startActivity(Landroid/content/Intent;)V
 
     invoke-virtual {v0}, Lcom/android/camera/Camera;->pj()Z
-- 
